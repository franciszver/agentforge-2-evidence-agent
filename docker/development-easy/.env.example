# Copy this file to `.env` in this same directory (docker/development-easy/)
# before bringing up the Co-Pilot overlay (docker-compose.copilot.yml).
# `docker compose` reads a `.env` file here automatically -- no extra flag
# needed. Real values belong ONLY in the untracked `.env`, never here.

# Required by docker-compose.copilot.yml's `agent` service (issue #180):
# keys TraceStore.hash_owner_token's /feedback ownership hash, and must
# stay stable across agent restarts now that traces.db persists in the
# `agenttracedata` volume -- see that compose file's comment on this
# variable, and app/config.py's `trace_args_hash_secret` docstring, for
# why an unset/rotating value is a real (not just theoretical) problem
# once trace data outlives a container. Generate a value with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TRACE_ARGS_HASH_SECRET=
