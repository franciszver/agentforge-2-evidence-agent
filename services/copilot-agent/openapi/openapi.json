{
  "components": {
    "schemas": {
      "ChatRequest": {
        "description": "``POST /chat`` request body.",
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "message": {
            "maxLength": 4000,
            "title": "Message",
            "type": "string"
          },
          "patient_id": {
            "title": "Patient Id",
            "type": "integer"
          }
        },
        "required": [
          "message",
          "patient_id"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "FeedbackRequest": {
        "description": "``POST /feedback`` request body.",
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "correlation_id": {
            "minLength": 1,
            "title": "Correlation Id",
            "type": "string"
          },
          "thumb": {
            "$ref": "#/components/schemas/FeedbackThumb"
          }
        },
        "required": [
          "correlation_id",
          "thumb"
        ],
        "title": "FeedbackRequest",
        "type": "object"
      },
      "FeedbackResponse": {
        "description": "``POST /feedback`` response body: confirms what was recorded and its linkage.",
        "properties": {
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "thumb": {
            "$ref": "#/components/schemas/FeedbackThumb"
          }
        },
        "required": [
          "correlation_id",
          "thumb"
        ],
        "title": "FeedbackResponse",
        "type": "object"
      },
      "FeedbackThumb": {
        "enum": [
          "up",
          "down"
        ],
        "title": "FeedbackThumb",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ReadyCheckBody": {
        "description": "OpenAPI-facing shape of a single ``GET /ready`` check entry.\n\nDeclared separately from ``CheckResult`` (a plain dataclass): this model\nexists only so ``app.main``'s ``responses=`` route metadata can document\nthe real ``/ready`` body shape for BOTH the 200 and 503 cases -- the\nhandler still builds the body by hand (it returns a ``JSONResponse``,\nnot this model, since the status code varies), so this is spec-accuracy\nonly and changes no runtime behavior.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "detail"
        ],
        "title": "ReadyCheckBody",
        "type": "object"
      },
      "ReadyResponseBody": {
        "description": "OpenAPI-facing shape of the full ``GET /ready`` response body.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ReadyCheckBody"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponseBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "copilot-agent",
    "version": "0.1.0"
  },
