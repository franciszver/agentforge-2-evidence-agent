# logs
/logs

# environment vars
.env

# vendor and assets
node_modules
/vendor/*

# oe-module-claimrev-connect is installed as a Composer dependency
# (claimrevolution/oe-module-claimrev-connect) and relocated into this path by
# the oe-module-installer-plugin during `composer install`. Never commit the
# installed copy.
/interface/modules/custom_modules/oe-module-claimrev-connect/*
/public/assets/*
/public/themes/*
!/public/assets/modified
/.docs/.out/*

# ccda service build
ccdaservice/node_modules

# dev editor configs
/.idea/*
/.vscode/*
/.vscode-oss/*
/nbproject/*
.DS_Store
.buildpath
.project
.settings

# testing
.phpunit.result.cache

# dev tool local overrides
phpcs.xml
phpstan.neon
coverage/js-unit

# phpstan
tmp-phpstan/*

# easy dev worktree support
.worktrees.json
.worktrees.json.lock
docker/development-easy/docker-compose.override.yml
docker/development-easy-light/docker-compose.override.yml
docker/development-easy-redis/docker-compose.override.yml
compose.override.yml
tmp/
.webpack-cache/

# Demo video pipeline output for issue #148. NOT regenerable from a clean
# clone: scripts/generate_demo_video.py reads its 9 source screenshots from
# tmp/, which is itself gitignored above, so both the source frames and this
# mp4 are local-only. The gif is the only committed artifact, at
# docs/assets/demo.gif. Note: docs/demo/ holds a pre-existing, unrelated
# tracked demo asset pair -- not touched by this rule.
docs/assets/demo.mp4

# AgentForge Phase 1 PRD reference docs and local planning (kept local, not published)
/prd/

# Decision log is kept local (lives at prd/DECISIONS.md); never re-add here
/docs/DECISIONS.md

# Local research/planning notes (thoughts tooling)
/thoughts/

# Python virtualenvs and caches
services/copilot-agent/.venv/
__pycache__/
.pytest_cache/
*.egg-info/
.coverage

# Dev-only OpenEMR OAuth client credentials + tokens (NEVER commit secrets)
services/copilot-agent/.openemr-dev-client.json

# Issue #163 (and any future evals/results/issue-NNN/draws/ harness): raw
# per-case LLM call transcripts are a local-only audit trail, never committed
# -- same as evals/results/issue-130's precedent (draws/*.json summaries are
# committed; draws/*.calls.json transcripts are not). This rule makes that
# property structural (git add -A can no longer stage one by accident)
# rather than relying on nobody ever running a broad add.
evals/results/**/*.calls.json
